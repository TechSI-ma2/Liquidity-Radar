# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Coinbase Advanced Trade WebSocket & REST Endpoints
COINBASE_WS_URL="wss://advanced-trade-ws.coinbase.com"
COINBASE_V3_PRODUCTS_URL="https://api.coinbase.com/api/v3/brokerage/market/products"
COINBASE_EXCHANGE_REST_URL="https://api.exchange.coinbase.com/products"

# Optional Server-Side Coinbase API Credentials
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# Optional Telegram Bot Alert Webhook
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
